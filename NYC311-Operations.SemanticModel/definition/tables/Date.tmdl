	column 'Precip Bucket'
		dataType: string
		lineageTag: 19dd88ff-c569-5255-86aa-2a8bd78ce6ee
		summarizeBy: none
		sourceColumn: 'Precip Bucket'
		sortByColumn: 'Precip Bucket Sort'

		annotation SummarizationSetBy = User

	column 'Precip Bucket Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4ecd12ce-21dc-5e0a-84bd-fa0442199f65
		summarizeBy: none
		sourceColumn: 'Precip Bucket Sort'

		annotation SummarizationSetBy = User

	hierarchy Calendar
		lineageTag: 8c98d3d0-43c8-5e5a-86c5-a9a6996d2b72

		level Year
			lineageTag: 03043669-4eca-558a-8384-a068f8e8044c
			column: Year

		level Quarter
			lineageTag: fb3ad922-7a1a-5b18-9ed9-a1a14b60128d
			column: Quarter

		level 'Month Name'
			lineageTag: 3bf33a47-96a0-5aa4-8028-dd7921b786bf
			column: 'Month Name'

		level Date
			lineageTag: 59a54e17-33d3-52c4-ae68-7f91531a6727
			column: Date

	hierarchy Fiscal
		lineageTag: 85debe6a-4d9d-589b-916c-dea3b8fc0a6c

		level 'Fiscal Year'
			lineageTag: 335b9a38-96dc-5672-938d-1481f3b1dbd9
			column: 'Fiscal Year'

		level 'Fiscal Month No'
			lineageTag: e38e6a71-4f06-56bb-a15d-d8f71b965588
			column: 'Fiscal Month No'

		level Date
			lineageTag: 7730c951-bcde-52bc-87dd-abbdda397379
			column: Date

	partition Date = m
		mode: import
		queryGroup: Dimensions
		source =
				let
					W = #"Data Window",
					StartDate = #date(2024, 1, 1),
					EndDate = #date(2026, 12, 31),
					Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
					T = Table.FromList(Dates, Splitter.SplitByNothing(), type table [Date = date]),
					Year = Table.AddColumn(T, "Year", each Date.Year([Date]), Int64.Type),
					Quarter = Table.AddColumn(Year, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
					MonthNo = Table.AddColumn(Quarter, "Month No", each Date.Month([Date]), Int64.Type),
					MonthName = Table.AddColumn(MonthNo, "Month Name", each Date.ToText([Date], [Format = "MMM", Culture = "en-US"]), type text),
					YearMonth = Table.AddColumn(MonthName, "Year Month", each Date.ToText([Date], [Format = "yyyy-MM", Culture = "en-US"]), type text),
					FYNo = Table.AddColumn(YearMonth, "Fiscal Year No", each if Date.Month([Date]) >= 7 then Date.Year([Date]) + 1 else Date.Year([Date]), Int64.Type),
					FY = Table.AddColumn(FYNo, "Fiscal Year", each "FY" & Text.From([Fiscal Year No]), type text),
					FMonth = Table.AddColumn(FY, "Fiscal Month No", each Number.Mod(Date.Month([Date]) + 5, 12) + 1, Int64.Type),   // Jul = 1 ... Jun = 12
					DowNo = Table.AddColumn(FMonth, "Day of Week No", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),        // Mon = 1
					DayName = Table.AddColumn(DowNo, "Day Name", each Date.ToText([Date], [Format = "ddd", Culture = "en-US"]), type text),
					Weekend = Table.AddColumn(DayName, "Is Weekend", each [Day of Week No] >= 6, type logical),
					InWindow = Table.AddColumn(Weekend, "In Data Window", each [Date] >= W[WindowStart] and [Date] <= W[WindowEnd], type logical),
					Mature = Table.AddColumn(InWindow, "Is Mature Cohort", each [Date] <= Date.AddDays(DateTime.Date(W[AsOf]), -30), type logical),
					WeatherJoin = Table.NestedJoin(Mature, {"Date"}, Weather, {"Date"}, "WeatherT", JoinKind.LeftOuter),
					WeatherCols = Table.ExpandTableColumn(WeatherJoin, "WeatherT", {"Temp Max C", "Temp Min C", "Precip mm", "Snow cm"}),
					Bucket = Table.AddColumn(WeatherCols, "Precip Bucket", each
						if [Precip mm] = null then "Unknown" else if [Precip mm] < 0.2 then "Dry"
						else if [Precip mm] < 5 then "Light" else if [Precip mm] < 20 then "Moderate" else "Heavy", type text),
					BucketSort = Table.AddColumn(Bucket, "Precip Bucket Sort", each
						if [Precip Bucket] = "Dry" then 1 else if [Precip Bucket] = "Light" then 2
						else if [Precip Bucket] = "Moderate" then 3 else if [Precip Bucket] = "Heavy" then 4 else 5, Int64.Type),
					Sorted = Table.Sort(BucketSort, {{"Date", Order.Ascending}}),
					Typed = Table.TransformColumnTypes(Sorted, {{"Date", type date}, {"Temp Max C", type number}, {"Temp Min C", type number},
						{"Precip mm", type number}, {"Snow cm", type number}})
				in
					Typed

