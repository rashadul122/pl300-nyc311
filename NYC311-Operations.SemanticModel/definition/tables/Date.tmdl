/// Calendar 2024-01-01 to 2026-12-31, marked as the date table (SPEC 5.1)
table Date
	lineageTag: 483044e8-5c56-5f04-8bdc-c7f8ca8ddca0
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: f5ea55c3-596b-57b2-bc21-c335bec9fa8a
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 314d5022-c2cb-5efb-911b-b7fb875ec035
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column Quarter
		dataType: string
		lineageTag: a5bbce09-b1dd-5491-97ae-f21bf851e8f3
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = User

	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: 760e0f84-4d2e-5333-8839-2459c1af4ff0
		summarizeBy: none
		sourceColumn: 'Month No'

		annotation SummarizationSetBy = User

	column 'Month Name'
		dataType: string
		lineageTag: 0c47528f-2c4c-5cd3-b1ed-84f602fc0a57
		summarizeBy: none
		sourceColumn: 'Month Name'
		sortByColumn: 'Month No'

		annotation SummarizationSetBy = User

	column 'Year Month'
		dataType: string
		lineageTag: 95658ab4-660c-56b0-837b-245b23439949
		summarizeBy: none
		sourceColumn: 'Year Month'

		annotation SummarizationSetBy = User

	column 'Fiscal Year No'
		dataType: int64
		formatString: 0
		lineageTag: 8ad9ee9d-b213-550f-80db-8c2c274194f9
		summarizeBy: none
		sourceColumn: 'Fiscal Year No'

		annotation SummarizationSetBy = User

	column 'Fiscal Year'
		dataType: string
		lineageTag: dbd10468-3051-5099-9c39-6664b31a2da1
		summarizeBy: none
		sourceColumn: 'Fiscal Year'
		sortByColumn: 'Fiscal Year No'

		annotation SummarizationSetBy = User

	column 'Fiscal Month No'
		dataType: int64
		formatString: 0
		lineageTag: b39dd0b6-fa41-58a0-b77f-7c3dd7cae3cb
		summarizeBy: none
		sourceColumn: 'Fiscal Month No'

		annotation SummarizationSetBy = User

	column 'Day of Week No'
		dataType: int64
		formatString: 0
		lineageTag: e3f83608-086d-5ad6-a487-9ccb6bf1e91e
		summarizeBy: none
		sourceColumn: 'Day of Week No'

		annotation SummarizationSetBy = User

	column 'Day Name'
		dataType: string
		lineageTag: 6930c73c-c1f8-5479-877d-1870093e7e0c
		summarizeBy: none
		sourceColumn: 'Day Name'
		sortByColumn: 'Day of Week No'

		annotation SummarizationSetBy = User

	column 'Is Weekend'
		dataType: boolean
		lineageTag: 58d1805c-a2cd-5cf9-8ae3-e8c8a7251002
		summarizeBy: none
		sourceColumn: 'Is Weekend'

		annotation SummarizationSetBy = User

	column 'In Data Window'
		dataType: boolean
		lineageTag: aa44f61b-4cbe-56e2-a675-7150401a3f79
		summarizeBy: none
		sourceColumn: 'In Data Window'

		annotation SummarizationSetBy = User

	column 'Is Mature Cohort'
		dataType: boolean
		lineageTag: 49ef60c9-1381-548c-9a8c-fd3ff98b9914
		summarizeBy: none
		sourceColumn: 'Is Mature Cohort'

		annotation SummarizationSetBy = User

	column 'Temp Max C'
		dataType: double
		formatString: #,##0.0
		lineageTag: deaa6a92-6b2a-5c69-8883-bb6acee413c3
		summarizeBy: average
		sourceColumn: 'Temp Max C'

		annotation SummarizationSetBy = User

	column 'Temp Min C'
		dataType: double
		formatString: #,##0.0
		lineageTag: aa34c37f-94de-5b61-ab23-b7785beee7d0
		summarizeBy: average
		sourceColumn: 'Temp Min C'

