	partition 'Age Band' = calculated
		mode: import
		source =
				DATATABLE (
					"Age Band Key", INTEGER,
					"Age Band", STRING,
					"Min Days", INTEGER,
					"Max Days", INTEGER,
					{
						{ 0, "Not open at window end", BLANK (), BLANK () },    // round 4: R19 assigns 0 to every other row
						{ 1, "0-7 days", 0, 7 },
						{ 2, "8-30 days", 8, 30 },
						{ 3, "31-90 days", 31, 90 },
						{ 4, "91-365 days", 91, 365 },
						{ 5, "Over 365 days (stale)", 366, 99999 }
					}
				)

