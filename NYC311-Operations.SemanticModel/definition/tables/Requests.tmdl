	/// 1 = breached, 0 = met, BLANK = not assessable (SPEC 5.4)
	column 'Breach Flag' =
			VAR Bench = RELATED ( Complaint[Benchmark Hours] )
			RETURN
				IF (
					Requests[Valid For Resolution] && NOT ISBLANK ( Bench ),
					IF ( Requests[Resolution Minutes] > Bench * 60, 1, 0 )
				)
		dataType: int64
		formatString: 0
		lineageTag: 600d8511-77be-5331-aeef-a4f18a5945cf
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Lower edge of the 1-day (1,440-minute) bin; BLANK where Resolution Minutes is BLANK
	column 'Resolution Minutes (bins)' =
			IF (
				NOT ISBLANK ( Requests[Resolution Minutes] ),
				INT ( Requests[Resolution Minutes] / 1440 ) * 1440
			)
		dataType: int64
		formatString: #,##0
		lineageTag: 1b275aa2-7b8d-5783-bbe1-c8e14644a27e
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition Requests = m
		mode: import
		queryGroup: Facts
		source =
				let
					Raw = fnReadRole("window"),
					Clean = fnCleanRequests(Raw, #"Data Window"[WindowEnd])
				in
					Clean

