/// Reads the manifest and fetches every file it lists (one SOURCE query; Formula.Firewall)
expression 'Source Files' =
		let
			ManifestDoc = Json.Document(
				Web.Contents(pDataBaseUrl, [RelativePath = "raw/main/data/" & pProfile & "/manifest.json"]), 65001),
			Folder = if pProfile = "full" then "releases/download/data-v1/" else "raw/main/data/dev/",
			Names = List.Transform(ManifestDoc[files], each _[name]),
			Fetched = List.Transform(Names, (n) =>
				let
					Response = Web.Contents(pDataBaseUrl, [RelativePath = Folder & n, ManualStatusHandling = {404}]),
					Status = Value.Metadata(Response)[Response.Status]
				in
					[name = n, Status = Status, Content = Response]),
			T = Table.FromRecords(Fetched, type table [name = text, Status = number, Content = binary]),
			Missing = Table.SelectRows(T, each [Status] = 404),
			Checked =
				if Table.RowCount(Missing) > 0
				then error Error.Record("Missing file", "manifest.json lists files that are not at the source", Text.Combine(Missing[name], ", "))
				else Table.SelectColumns(T, {"name", "Content"})
		in
			Checked
	lineageTag: e59e0290-4c7e-5e2b-ba6e-dc8f429b957c
	queryGroup: Staging

	annotation PBI_ResultType = Table

expression Manifest =
		let
			Doc = Json.Document(
				Web.Contents(pDataBaseUrl, [RelativePath = "raw/main/data/" & pProfile & "/manifest.json"]), 65001)
		in
			Doc
	lineageTag: ccaf5d69-55e6-57a8-abcb-1233b8ece985
	queryGroup: Staging

	annotation PBI_ResultType = Record

expression 'Data Window' =
		let
			M = Manifest,
			AsOfList = List.Transform(M[files], each DateTime.FromText(_[as_of], [Format = "yyyy-MM-dd'T'HH:mm:ss", Culture = "en-US"])),
			Result = [
				Profile = M[profile],
				WindowStart = Date.FromText(M[window_start], [Format = "yyyy-MM-dd", Culture = "en-US"]),
				WindowEnd = Date.FromText(M[window_end], [Format = "yyyy-MM-dd", Culture = "en-US"]),
				AsOf = List.Min(AsOfList)
			]
		in
			Result
	lineageTag: d796158a-6ba9-506b-a6b7-5eaeb67d3ce2
	queryGroup: Staging

	annotation PBI_ResultType = Record

expression 'Manifest Files' =
		let
			Files = Table.FromRecords(Manifest[files], null, MissingField.UseNull),
			Typed = Table.TransformColumnTypes(Files, {
				{"name", type text}, {"role", type text}, {"month", type text}, {"rows", Int64.Type},
				{"sha256", type text}, {"bytes", Int64.Type}, {"dialect", type text}, {"source", type text},
				{"as_of", type text}}),
			AsOf = Table.AddColumn(Typed, "As Of",
				each DateTime.FromText([as_of], [Format = "yyyy-MM-dd'T'HH:mm:ss", Culture = "en-US"]), type datetime)
		in
			AsOf
	lineageTag: f35e74c6-d36c-5103-b73e-6fd02ddeba7f
	queryGroup: Staging

	annotation PBI_ResultType = Table

expression 'Extract Files' =
		let
			// round 6: Source Files already stopped on a missing file; this query accesses no source
			Joined = Table.NestedJoin(#"Manifest Files", {"name"}, #"Source Files", {"name"}, "Src", JoinKind.LeftOuter),
			WithContent = Table.ExpandTableColumn(Joined, "Src", {"Content"}, {"Content"}),
			WithData = Table.AddColumn(WithContent, "Data",
				each Table.PromoteHeaders(
					Csv.Document(
						Binary.Decompress([Content], Compression.GZip),
						[Delimiter = ",", Columns = 19, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					[PromoteAllScalars = true]),
				type table),
			Kept = Table.SelectColumns(WithData, {"name", "role", "dialect", "As Of", "Data"})
		in
			Kept
	lineageTag: b6437ece-51b7-5dfd-b7f4-10946853b64c
	queryGroup: Staging

