	annotation PBI_ResultType = Table

/// Open-Meteo daily archive, the grid cell the API picks for Central Park (it returns 40.81 N, 74.02 W, New Jersey side); typed empty fallback
expression Weather =
		let
			// Accept-Encoding gzip: offered "gzip, deflate" (the service's default), Open-Meteo answers with
			// zlib-wrapped deflate, which the service's HTTP stack cannot decode ("Found invalid data while
			// decoding", refresh 2, 25 Sep 2026); that failure is raised below M, so try cannot catch it.
			// Binary.Buffer reads the whole response inside try, so any M-level failure still falls back.
			Raw = try Json.Document(Binary.Buffer(Web.Contents("https://archive-api.open-meteo.com", [
					RelativePath = "v1/archive",
					Headers = [#"Accept-Encoding" = "gzip"],
					Query = [
						latitude = pWeatherLat, longitude = pWeatherLon,
						start_date = "2024-01-01", end_date = pWeatherEnd,
						daily = "temperature_2m_max,temperature_2m_min,precipitation_sum,snowfall_sum",
						timezone = "America/New_York"]]))) otherwise null,
			Empty = #table(type table [Date = date, #"Temp Max C" = number, #"Temp Min C" = number, #"Precip mm" = number, #"Snow cm" = number], {}),
			D = if Raw = null then null else Record.FieldOrDefault(Raw, "daily", null),
			Result =
				if D = null then Empty
				else Table.FromColumns(
					{
						List.Transform(D[time], each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"])),
						D[temperature_2m_max], D[temperature_2m_min], D[precipitation_sum], D[snowfall_sum]
					},
					type table [Date = date, #"Temp Max C" = number, #"Temp Min C" = number, #"Precip mm" = number, #"Snow cm" = number])
		in
			Result
	lineageTag: dc8b2fea-99a3-5cd7-a481-51fe846f5060
	queryGroup: Staging

	annotation PBI_ResultType = Table

expression fnCleanText =
		(t as nullable text) as nullable text =>
		let
			s = if t = null then null else Text.Trim(Text.Clean(t))
		in
			if s = "" then null else s
	lineageTag: 2e656ecd-8daf-5c00-a60d-1429757137f1
	queryGroup: Functions

	annotation PBI_ResultType = Function

expression fnParseDateTime =
		(t as nullable text) as nullable datetime =>
		let
			s = if t = null then null else Text.Trim(t)
		in
			if s = null or s = "" then null
			else DateTime.FromText(s, [Format = "MM/dd/yyyy hh:mm:ss tt", Culture = "en-US"])
	lineageTag: 24a485c0-1f7a-568f-b179-90ef7c065daf
	queryGroup: Functions

	annotation PBI_ResultType = Function

expression fnNormalizeKey =
		(t as nullable text) as nullable text =>
		let
			s0 = if t = null then null else Text.Upper(Text.Trim(Text.Clean(t))),
			s1 = if s0 = null then null else Text.Remove(s0, {"'", "’"}),
			s2 = if s1 = null then null else Text.Combine(List.Select(Text.Split(s1, " "), each _ <> ""), " "),
			s3 = if s2 = null then null else Text.Replace(s2, " / ", "/")
		in
			if s3 = null or s3 = "" then null else s3
	lineageTag: 0ca093ec-8338-560e-b113-46e9175de0aa
	queryGroup: Functions

	annotation PBI_ResultType = Function

expression fnComplaintKey =
		(t as nullable text) as text =>
		let
			k = fnNormalizeKey(t),
			k2 = if k = null then "(NONE)" else k
		in
			Record.FieldOrDefault(#"Complaint Alias Map", k2, k2)
	lineageTag: 1a022421-6a5b-5c3d-a3ad-c018e73a2b59
	queryGroup: Functions

	annotation PBI_ResultType = Function

expression fnReadRole =
		(role as text) as table =>
		let
			Files = Table.SelectRows(#"Extract Files", each [role] = role),
			Tagged = Table.AddColumn(Files, "Tagged", (f) =>
				Table.AddColumn(
					Table.AddColumn(f[Data], "Source File", each f[name], type text),
					"As Of", each f[#"As Of"], type datetime)),
			Combined = Table.Combine(Tagged[Tagged])
		in
			Combined
	lineageTag: 2ba11e8c-4164-5ade-a97c-283b58e92631
	queryGroup: Functions

	annotation PBI_ResultType = Function

expression fnCleanRequests =
		(raw as table, windowEnd as date) as table =>
		let
			Kept = Table.SelectColumns(raw, {"unique_key", "created_date", "closed_date", "agency", "complaint_type",
				"descriptor", "incident_zip", "borough", "status", "open_data_channel_type", "Source File", "As Of"}),
		
			// R01 text hygiene
			TextCols = {"unique_key", "created_date", "closed_date", "agency", "complaint_type", "descriptor",
				"incident_zip", "borough", "status", "open_data_channel_type"},
			R01 = Table.TransformColumns(Kept, List.Transform(TextCols, (c) => {c, fnCleanText, type nullable text})),
		
			// R02 parse; failures -> null + flag
			Created = Table.AddColumn(R01, "Created", each try fnParseDateTime([created_date]) otherwise null, type nullable datetime),
			ClosedRaw = Table.AddColumn(Created, "Closed Raw", each try fnParseDateTime([closed_date]) otherwise null, type nullable datetime),
			R02 = Table.AddColumn(ClosedRaw, "R02 Parse", each
				if [created_date] <> null and [Created] = null then "created_unparseable"
				else if [closed_date] <> null and [#"Closed Raw"] = null then "closed_unparseable"
				else null, type nullable text),
		
			// R03 close validity against the row's OWN file as_of; first matching reason wins
			R03 = Table.AddColumn(R02, "R03 Close", each
				if [#"Closed Raw"] = null or [Created] = null then "missing"
				else if Date.Year([#"Closed Raw"]) < 2020 then "pre_2020"
				else if [#"Closed Raw"] < [Created] then "negative"
				else if [#"Closed Raw"] > [#"As Of"] then "after_as_of"
				else null, type nullable text),
			ClosedValid = Table.AddColumn(R03, "Closed Valid", each [#"R03 Close"] = null, type logical),
			ClosedDate = Table.AddColumn(ClosedValid, "Closed Date",
				each if [Closed Valid] then DateTime.Date([#"Closed Raw"]) else null, type nullable date),
		
			// R04 whole minutes, rounded down
			Minutes = Table.AddColumn(ClosedDate, "Resolution Minutes",
				each if [Closed Valid] then Number.RoundDown(Duration.TotalMinutes([#"Closed Raw"] - [Created])) else null, Int64.Type),
		
			// R05
			R05 = Table.AddColumn(Minutes, "R05 Resolution", each
				if not [Closed Valid] then null
				else if [Resolution Minutes] < 1 then "zero"
				else if [Resolution Minutes] > 525600 then "over_1y"
				else null, type nullable text),
			Valid = Table.AddColumn(R05, "Valid For Resolution", each [Closed Valid] and [#"R05 Resolution"] = null, type logical),
		
			// R06
			R06 = Table.AddColumn(Valid, "R06 Day Precision",
				each if [Closed Valid] and DateTime.Time([#"Closed Raw"]) = #time(0, 0, 0) then "day_precision" else null, type nullable text),
		
			// R07 and R18 (status vs close); eligibility also needs a created date
			R07 = Table.AddColumn(R06, "R07 Status Conflict",
				each if [status] = "Closed" and not [Closed Valid] then "status_conflict" else null, type nullable text),
			R18 = Table.AddColumn(R07, "R18 Open Invalid Close",
				each if [status] <> "Closed" and [closed_date] <> null and not [Closed Valid] then "open_invalid_close" else null, type nullable text),
			Eligible = Table.AddColumn(R18, "Backlog Eligible", each [#"R07 Status Conflict"] = null and [Created] <> null, type logical),
		
			// R08 agency remap
			Agency = Table.AddColumn(Eligible, "Agency", each
				let a = Text.Upper([agency]) in if a = null then "UNKNOWN" else Record.FieldOrDefault(#"Agency Remap Map", a, a), type text),
		
			// R09 complaint key, R10 descriptor
			Complaint = Table.AddColumn(Agency, "Complaint Key", each fnComplaintKey([complaint_type]), type text),
			Descriptor = Table.AddColumn(Complaint, "Descriptor", each
				let k = fnNormalizeKey([descriptor]) in if k = null or k = "N/A" or k = "UNSPECIFIED" then "(NONE)" else k, type text),
		
			// R12 borough
			Boroughs = {"BRONX", "BROOKLYN", "MANHATTAN", "QUEENS", "STATEN ISLAND"},
			Borough = Table.AddColumn(Descriptor, "Borough", each
				let b = Text.Upper([borough]) in if List.Contains(Boroughs, b) then b else "UNKNOWN", type text),
			R12 = Table.AddColumn(Borough, "R12 Borough", each if [Borough] = "UNKNOWN" then "unknown" else null, type nullable text),
		
			// R13 ZIP
			Zip = Table.AddColumn(R12, "ZIP", each
				let z = [incident_zip] in
				if z <> null and Text.Length(z) = 5 and Text.Select(z, {"0".."9"}) = z
					and Number.From(z) >= 10000 and Number.From(z) <= 14999
				then z else "UNKNOWN", type text),
			R13 = Table.AddColumn(Zip, "R13 ZIP", each
				if [incident_zip] = null then "missing" else if [ZIP] = "UNKNOWN" then "invalid" else null, type nullable text),
		
			// R17 channel
			Channel = Table.AddColumn(R13, "Channel", each
				let c = Text.Upper([open_data_channel_type]) in
				if c = null or c = "UNKNOWN" then "UNKNOWN"
				else if List.Contains({"ONLINE", "PHONE", "MOBILE", "OTHER"}, c) then c
				else "OTHER", type text),
		
			// Created date / hour (the datetime is split; minutes and seconds dropped)
			CreatedDate = Table.AddColumn(Channel, "Created Date", each if [Created] = null then null else DateTime.Date([Created]), type nullable date),
			CreatedHour = Table.AddColumn(CreatedDate, "Created Hour", each if [Created] = null then null else Time.Hour([Created]), Int64.Type),
		
			// R19 age band at window end: every eligible row open at window end, whatever its age (band 5 = stale)
			AgeBand = Table.AddColumn(CreatedHour, "Age Band Key", each
				if [Backlog Eligible] and [Created Date] <= windowEnd
					and ([Closed Date] = null or [Closed Date] > windowEnd)
				then
					let d = Duration.Days(windowEnd - [Created Date]) in
					if d <= 7 then 1 else if d <= 30 then 2 else if d <= 90 then 3 else if d <= 365 then 4 else 5
				else 0, Int64.Type),                                   // round 4: 0 = "Not open at window end", never null
		
			// R20 backlog exit: close within 365 days, else aged out at created + 366; kept only up to the window end
			ExitDate = Table.AddColumn(AgeBand, "Backlog Exit Date", each
				if not [Backlog Eligible] then null
				else
					let
						closedInLife = [Closed Date] <> null and [Closed Date] <= Date.AddDays([Created Date], 365),
						exit = if closedInLife then [Closed Date] else Date.AddDays([Created Date], 366)
					in
						if exit <= windowEnd then exit else null, type nullable date),
			ExitType = Table.AddColumn(ExitDate, "Backlog Exit", each
				if [Backlog Exit Date] = null then null
				else if [Closed Date] <> null and [Closed Date] <= Date.AddDays([Created Date], 365) then "Closed"
				else "Aged out", type nullable text),
		
			// R16 key + de-duplication (v1: expected no-op; v2 sorts by As Of desc + Table.Buffer first)
			Key = Table.AddColumn(ExitType, "Unique Key", each Int64.From([unique_key]), Int64.Type),
			Dedup = Table.Distinct(Key, {"Unique Key"}),
		
			// Remove helpers; set types LAST
			Renamed = Table.RenameColumns(Dedup, {{"status", "Status"}}),
			Selected = Table.SelectColumns(Renamed, {
				"Unique Key", "Source File", "Created Date", "Created Hour", "Closed Date", "Closed Valid",
				"Resolution Minutes", "Valid For Resolution", "Backlog Eligible", "Backlog Exit Date", "Backlog Exit",
				"Status", "Agency", "Complaint Key", "Descriptor", "Borough", "Channel", "ZIP", "Age Band Key",
				"R02 Parse", "R03 Close", "R05 Resolution", "R06 Day Precision", "R07 Status Conflict",
				"R12 Borough", "R13 ZIP", "R18 Open Invalid Close"}),
			Typed = Table.TransformColumnTypes(Selected, {
				{"Unique Key", Int64.Type}, {"Source File", type text}, {"Created Date", type date}, {"Created Hour", Int64.Type},
				{"Closed Date", type date}, {"Closed Valid", type logical}, {"Resolution Minutes", Int64.Type},
				{"Valid For Resolution", type logical}, {"Backlog Eligible", type logical},
				{"Backlog Exit Date", type date}, {"Backlog Exit", type text}, {"Status", type text},
				{"Agency", type text}, {"Complaint Key", type text}, {"Descriptor", type text}, {"Borough", type text},
				{"Channel", type text}, {"ZIP", type text}, {"Age Band Key", Int64.Type},
				{"R02 Parse", type text}, {"R03 Close", type text}, {"R05 Resolution", type text}, {"R06 Day Precision", type text},
				{"R07 Status Conflict", type text}, {"R12 Borough", type text}, {"R13 ZIP", type text}, {"R18 Open Invalid Close", type text}})
		in
			Typed
	lineageTag: fe4fcc7a-3718-534a-82a6-95762c3b8211
	queryGroup: Functions

	annotation PBI_ResultType = Function

/// Error cells per column of the typed outputs; not loaded, run it in dev mode
expression 'Load Errors' =
		let
			ErrorsIn = (t as table, label as text) as table =>
				Table.FromRecords(List.Transform(Table.ColumnNames(t), (c) =>
					[Table = label, Column = c, #"Error Cells" = Table.RowCount(Table.SelectRowsWithErrors(t, {c}))])),
			Result = Table.Combine({ErrorsIn(Requests, "Requests"), ErrorsIn(#"Opening Backlog", "Opening Backlog")})
		in
			Result
	lineageTag: 587f2b24-0d1e-5152-8179-40c46a958649
	queryGroup: Diagnostics

	annotation PBI_ResultType = Table

