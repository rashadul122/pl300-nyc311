// C5b - golden rows of the carry-in table ('Opening Backlog'), dev profile: 6 keys
// generated by the engine (twin/golden.py) from SPEC 9.2 and twin/golden_keys.json
EVALUATE
CALCULATETABLE (
    SELECTCOLUMNS (
        'Opening Backlog',
        "Unique Key", 'Opening Backlog'[Unique Key], "Created Date", 'Opening Backlog'[Created Date],
        "Created Hour", 'Opening Backlog'[Created Hour], "Closed Date", 'Opening Backlog'[Closed Date],
        "Closed Valid", 'Opening Backlog'[Closed Valid], "Resolution Minutes", 'Opening Backlog'[Resolution Minutes],
        "Valid For Resolution", 'Opening Backlog'[Valid For Resolution], "Backlog Eligible", 'Opening Backlog'[Backlog Eligible],
        "Backlog Exit Date", 'Opening Backlog'[Backlog Exit Date], "Backlog Exit", 'Opening Backlog'[Backlog Exit],
        "Status", 'Opening Backlog'[Status], "Agency", 'Opening Backlog'[Agency], "Complaint Key", 'Opening Backlog'[Complaint Key],
        "Descriptor", 'Opening Backlog'[Descriptor], "Borough", 'Opening Backlog'[Borough], "Channel", 'Opening Backlog'[Channel],
        "ZIP", 'Opening Backlog'[ZIP], "Age Band Key", 'Opening Backlog'[Age Band Key],
        "R02", 'Opening Backlog'[R02 Parse], "R03", 'Opening Backlog'[R03 Close], "R05", 'Opening Backlog'[R05 Resolution],
        "R06", 'Opening Backlog'[R06 Day Precision], "R07", 'Opening Backlog'[R07 Status Conflict], "R12", 'Opening Backlog'[R12 Borough],
        "R13", 'Opening Backlog'[R13 ZIP], "R18", 'Opening Backlog'[R18 Open Invalid Close]
    ),
    TREATAS ( {
        58683675, 58683925, 58685800, 58745800, 59446500, 62144725
    }, 'Opening Backlog'[Unique Key] )
)
ORDER BY [Unique Key]
